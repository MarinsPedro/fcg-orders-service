  },
  "LibraryApi": {
    "BaseAddress": "http://localhost:62082/",
    "Audience": "library-api",
    "Scopes": "library.ownership.read"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
