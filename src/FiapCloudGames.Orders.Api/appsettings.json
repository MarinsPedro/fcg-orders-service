{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=fcg_orders;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "Authority": "https://identity.internal",
    "Issuer": "fiap-cloud-games-identity",
    "Audience": "orders-api",
    "AllowedTokenUses": [
      "service"
    ],
    "RequireHttpsMetadata": true,
    "ClockSkew": "00:00:30"
  },
  "ServiceAuthentication": {
    "Authority": "https://identity.internal",
    "ClientId": "service-template-api",
    "ClientSecret": "CONFIGURE_USING_ENVIRONMENT_OR_USER_SECRETS",
    "RequireHttps": true,
    "RefreshBeforeExpiration": "00:00:30",
    "DiscoveryRefreshInterval": "01:00:00",
    "HttpTimeout": "00:00:10",
    "RetryCount": 2,
    "RetryBaseDelay": "00:00:00.200",
    "MaxCachedTokens": 128,
    "RequireSameHostForDiscoveredTokenEndpoint": true,
    "AllowedTokenEndpointHosts": []
  },
  "CatalogApi": {
    "BaseAddress": "https://localhost:7003/",
    "Audience": "catalog-api",
    "Scopes": "catalog.status.read"
  },
  "PromotionsApi": {
    "BaseAddress": "https://localhost:7004/",
    "Audience": "promotions-api",
    "Scopes": "promotions.status.read"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
