{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=fcg_orders;Username=postgres;Password=postgres"
  },
  "Messaging": {
    "UseInMemory": false
  },
  "RabbitMq": {
    "Host": "127.0.0.1",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Authentication": {
    "Authority": "http://localhost:5081",
    "Issuer": "fiap-cloud-games-identity",
    "Audience": "orders-api",
    "AllowedTokenUses": [
      "service"
    ],
    "RequireHttpsMetadata": true,
    "ClockSkew": "00:00:30"
  },
  "ServiceAuthentication": {
    "Authority": "http://localhost:5081",
    "ClientId": "orders-api",
    "ClientSecret": "Fiap@123456",
    "RequireHttps": true,
    "RefreshBeforeExpiration": "00:00:30",
    "DiscoveryRefreshInterval": "01:00:00",
    "HttpTimeout": "00:00:10",
    "RetryCount": 2,
    "RetryBaseDelay": "00:00:00.200",
    "MaxCachedTokens": 128,
    "RequireSameHostForDiscoveredTokenEndpoint": true,
    "AllowedTokenEndpointHosts": []
  },
  "CatalogApi": {
    "BaseAddress": "https://localhost:7003/",
    "Audience": "catalog-api",
    "Scopes": "catalog.games.read"
  },
  "PromotionsApi": {
    "BaseAddress": "https://localhost:7004/",
    "Audience": "promotions-api",
    "Scopes": "promotions.calculate promotions.campaigns.read"
  },
  "LibraryApi": {
    "BaseAddress": "http://localhost:62082/",
    "Audience": "library-api",
    "Scopes": "library.ownership.read"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
