{
  "ConnectionStrings": {
    "Database": "Host=127.0.0.1;Port=5433;Database=fcg_orders;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "Host": "127.0.0.1",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "Topology": {
      "Exchanges": {
        "PurchaseOrderCreated": "orders.purchase-order-created.v1",
        "PaymentRequested": "payments.payment-requested.v1",
        "PaymentApproved": "payments.payment-approved.v1",
        "PaymentRejected": "payments.payment-rejected.v1",
        "GameGrantRequested": "library.game-grant-requested.v1",
        "GameGranted": "library.game-granted.v1",
        "OrderCompleted": "orders.order-completed.v1"
      },
      "Queues": {
        "PurchaseOrderSaga": "fcg-orders-purchase-order-saga"
      }
    }
  },
  "Authentication": {
    "Authority": "http://localhost:5081",
    "Issuer": "fiap-cloud-games-identity",
    "Audience": "orders-api",
    "AllowedTokenUses": [
      "service"
    ],
    "RequireHttpsMetadata": true,
    "ClockSkew": "00:00:30"
  },
  "ServiceAuthentication": {
    "Authority": "http://localhost:5081",
    "ClientId": "orders-api",
    "ClientSecret": "Fiap@123456",
    "RequireHttps": true,
    "RefreshBeforeExpiration": "00:00:30",
    "DiscoveryRefreshInterval": "01:00:00",
    "HttpTimeout": "00:00:10",
    "RetryCount": 2,
    "RetryBaseDelay": "00:00:00.200",
    "MaxCachedTokens": 128,
    "RequireSameHostForDiscoveredTokenEndpoint": true,
    "AllowedTokenEndpointHosts": []
  },
  "CatalogApi": {
    "BaseAddress": "https://localhost:7003/",
    "Audience": "catalog-api",
    "Scopes": "catalog.games.read"
  },
  "PromotionsApi": {
    "BaseAddress": "https://localhost:7004/",
